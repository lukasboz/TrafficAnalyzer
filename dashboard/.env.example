# Server-only variables: never prefix these with NEXT_PUBLIC_.
ANALYSIS_URL=https://your-flowstate-analysis.onrender.com
# Same value as FLOWSTATE_API_KEY on the backend, at least 32 characters.
ANALYSIS_KEY=replace-with-a-long-random-service-key
# Workspace sign-in, required in production, at least 12 characters.
DASHBOARD_PASSWORD=replace-with-a-long-workspace-password
# Local launchers generate .env.local automatically and enable loopback-only local mode.
